  "not_boundaries": [
    {
      "function": "qt_askname",
      "reason": "before moveloop; not a play boundary"
    },
    {
      "function": "qt_player_selection",
      "reason": "before moveloop; not a play boundary"
    },
    {
      "function": "qt_outrip",
      "reason": "game over; not a play boundary"
    },
    {
      "function": "any window procedure after program_state.gameover (for example the identify and inventory prompts at death)",
      "reason": "end of play; run comparisons stop at game over"
    },
    {
      "function": "qt_doprev_message",
      "reason": "returns at once; the Qt message window scrolls instead of waiting"
    },
    {
      "function": "qt_nhgetch inside qt_yn_function, qt_more or qt_get_ext_cmd; qt_yn_function inside qt_display_nhwindow(WIN_MAP)",
      "reason": "nested wait: the outermost window procedure is the boundary"
    },
    {
      "function": "a window procedure that returns queued keys, clicks or a toolbar command without entering its wait",
      "reason": "entering an input function is not a boundary"
    },
    {
      "function": "qt_timer_fire (idlecheckpoint)",
      "reason": "explicit core operation (F16/INV14); never a pure-paint boundary"
    },
    {
      "function": "Qt event processing without a core wait",
      "reason": "Qt being busy is not a core boundary"
    }
  ],
