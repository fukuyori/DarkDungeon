{
  "schema": "darkdungeon-boundary-ports-v1",
  "boundary_kinds": [
    "command-ready",
    "prompt-paused",
    "core-suspended"
  ],
  "barrier_keys": [
    "input_ready",
    "core_dispatch_pending",
    "display_preparation_pending",
    "modal"
  ],
  "barrier_meaning": {
    "input_ready": "the core is waiting for the player inside a window-port wait",
    "core_dispatch_pending": "a command or core operation is still in progress and continues after the wait",
    "display_preparation_pending": "the core has published part of a display sequence (tmp_at, delay) and continues it after the wait",
    "modal": "the wait answers a specific core request (prompt, --More--), not the top-level command wait; it is not Qt window modality"
  },
  "barriers": {
    "command-ready": {
      "input_ready": true,
      "core_dispatch_pending": false,
      "display_preparation_pending": false,
      "modal": false
    },
    "prompt-answer": {
      "input_ready": true,
      "core_dispatch_pending": true,
      "display_preparation_pending": false,
      "modal": true
    },
    "suspended-acknowledge": {
      "input_ready": true,
      "core_dispatch_pending": true,
      "display_preparation_pending": false,
      "modal": true
    },
    "suspended-timer": {
      "input_ready": false,
      "core_dispatch_pending": true,
      "display_preparation_pending": true,
      "modal": false
    }
  },
  "recording_rule": "record a point only when the outermost window procedure the core called enters its wait; nested waits are not points",
  "ports": [
    {
      "id": "qt_nh_poskey.command",
      "boundary_kind": "command-ready",
      "window_proc": "win_nh_poskey",
      "core_condition": "parse() reading the first key of a top-level command (readchar_core -> nh_poskey): with num_pad off the first read of get_count() before any digit, with num_pad on the readchar() before get_count(); input_state=commandInp, iflags.in_parse, multi=0, no occupation, Qt keybuffer and clickbuffer empty, no requested toolbar command, *readchar_queue empty, command queues CQ_CANNED and CQ_REPEAT empty, not gi.in_doagain, in_moveloop and not gameover",
      "barrier": "command-ready",
      "f18_branch": null
    },
    {
      "id": "qt_nh_poskey.count",
      "boundary_kind": "prompt-paused",
      "window_proc": "win_nh_poskey",
      "core_condition": "a read inside get_count() after one or more count digits (also after backspace back to zero), or with num_pad on after NHKF_COUNT; any caller (parse, the getobj count, splitting a stack) and any input_state",
      "barrier": "prompt-answer",
      "f18_branch": null
    },
    {
      "id": "qt_nhgetch.altmeta",
      "boundary_kind": "prompt-paused",
      "window_proc": "win_nhgetch",
      "core_condition": "pgetchar() for the key after ESC when altmeta is on and input_state is not otherInp (commandInp, getposInp, getdirInp; readchar_core)",
      "barrier": "prompt-answer",
      "f18_branch": null
    },
    {
      "id": "qt_nhgetch.doagain",
      "boundary_kind": "prompt-paused",
      "window_proc": "win_nhgetch",
      "core_condition": "pgetchar() while gi.in_doagain and *readchar_queue is empty (readchar_core)",
      "barrier": "prompt-answer",
      "f18_branch": null
    },
    {
      "id": "qt_yn_function.getdir",
      "boundary_kind": "prompt-paused",
      "window_proc": "win_yn_function",
      "core_condition": "getdir() direction prompt (input_state=getdirInp)",
      "barrier": "prompt-answer",
      "f18_branch": "direction"
    },
    {
      "id": "qt_yn_function.yn",
      "boundary_kind": "prompt-paused",
      "window_proc": "win_yn_function",
      "core_condition": "yn_function() outside getdir, including object letters (input_state=otherInp); with query_menu on the same question is a qt_select_menu.menu point",
      "barrier": "prompt-answer",
      "f18_branch": "yn"
    },
    {
      "id": "qt_nh_poskey.getpos",
