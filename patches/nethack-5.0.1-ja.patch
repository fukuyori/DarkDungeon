+static std::wstring s2w(const char *s) {
+  std::string src = std::string(s);
+  auto const dest_size = ::MultiByteToWideChar(CP_ACP, 0U, src.data(), -1, nullptr, 0U);
+  std::vector<wchar_t> dest(dest_size, L'\0');
